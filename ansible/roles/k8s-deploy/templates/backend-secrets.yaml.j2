apiVersion: v1
kind: Secret
metadata:
  name: "{{ project_name }}-secrets"
  namespace: "{{ k8s_namespace }}"
type: Opaque
data:
  # Values must be base64 encoded
  DATABASE_URL: "{{ database_url | b64encode }}"
  JWT_SECRET: "{{ jwt_secret | b64encode }}"
  NODE_ENV: "{{ node_env | default('staging') | b64encode }}"
